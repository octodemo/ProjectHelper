query OrgProject($login:String!$number:Int!){organization(login: $login){projectV2(number: $number){number,url,shortDescription,public,closed,title,id,readme,fields(first: 100){totalCount,nodes{__typename,... on ProjectV2Field{id,name,dataType},... on ProjectV2IterationField{id,name,dataType},... on ProjectV2SingleSelectField{id,name,dataType,options{id,name}}},pageInfo{endCursor,hasNextPage}},owner{__typename,... on User{login},... on Organization{login}}},login}}
